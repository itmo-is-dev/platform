{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "Platform",
    "Application"
  ],
  "properties": {
    "Platform": {
      "allOf": [
        {
          "required": [
            "Observability"
          ],
          "properties": {
            "Observability": {
              "allOf": [
                {
                  "required": [
                    "HealthChecks",
                    "Logging",
                    "Metrics",
                    "Sentry",
                    "Tracing"
                  ],
                  "properties": {
                    "HealthChecks": {
                      "allOf": [
                        {
                          "$ref": "#/definitions/Itmo_Dev_Platform_Observability_HealthChecks_PlatformHealthCheckOptions"
                        }
                      ]
                    },
                    "Logging": {
                      "allOf": [
                        {
                          "$ref": "#/definitions/Itmo_Dev_Platform_Observability_Logging_PlatformLoggingOptions"
                        }
                      ]
                    },
                    "Metrics": {
                      "allOf": [
                        {
                          "$ref": "#/definitions/Itmo_Dev_Platform_Observability_Metrics_PlatformMetricsOptions"
                        }
                      ]
                    },
                    "Sentry": {
                      "allOf": [
                        {
                          "$ref": "#/definitions/Itmo_Dev_Platform_Observability_Sentry_PlatformSentryOptions"
                        }
                      ]
                    },
                    "Tracing": {
                      "allOf": [
                        {
                          "$ref": "#/definitions/Itmo_Dev_Platform_Observability_Tracing_PlatformTracingOptions"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "Application": {
      "allOf": [
        {
          "required": [
            "SomeOptions"
          ],
          "properties": {
            "SomeOptions": {
              "allOf": [
                {
                  "$ref": "#/definitions/Itmo_Dev_Platform_Options_Samples_SomeOptions"
                }
              ]
            }
          }
        }
      ]
    }
  },
  "definitions": {
    "Itmo_Dev_Platform_Observability_Sentry_PlatformSentryOptions": {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "PlatformSentryOptions",
      "type": "object",
      "required": [
        "IsEnabled"
      ],
      "properties": {
        "IsEnabled": {
          "type": "boolean"
        },
        "Configuration": {}
      }
    },
    "Itmo_Dev_Platform_Observability_Logging_PlatformLoggingOptions": {
