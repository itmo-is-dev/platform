    "Itmo_Dev_Platform_MessagePersistence_Postgres_Configuration_MessagePersistencePostgresOptions": {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "MessagePersistencePostgresOptions",
      "type": "object",
      "required": [
        "SchemaName"
      ],
      "properties": {
        "SchemaName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Itmo_Dev_Platform_Kafka_Producer_KafkaProducerOptions": {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "KafkaProducerOptions",
      "type": "object",
      "required": [
        "Topic"
