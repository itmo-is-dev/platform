    "Itmo_Dev_Platform_Observability_HealthChecks_PlatformHealthCheckOptions": {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "PlatformHealthCheckOptions",
      "type": "object",
      "required": [
        "IsEnabled"
      ],
      "properties": {
        "IsEnabled": {
          "type": "boolean"
        },
        "StartupCheckUri": {
          "type": "string",
          "default": "/health/startup"
        },
        "ReadinessCheckUri": {
          "type": "string",
          "default": "/health/readyz"
        },
        "LivenessCheckUri": {
          "type": "string",
          "default": "/health/livez"
        }
      }
    },
