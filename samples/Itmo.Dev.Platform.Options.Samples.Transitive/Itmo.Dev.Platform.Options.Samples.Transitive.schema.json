      "title": "PlatformLoggingOptions",
      "type": "object",
      "properties": {
        "Serilog": {}
      }
    },
    "MessageHandleResultKind": {
      "type": "integer",
      "description": "",
      "x-enumNames": [
        "Success",
        "Failure",
        "Ignored"
      ],
      "enum": [
        0,
        1,
        2
      ]
    },
    "Itmo_Dev_Platform_MessagePersistence_Options_MessagePersistenceHandlerOptions": {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "MessagePersistenceHandlerOptions",
      "type": "object",
      "properties": {
        "DefaultHandleResult": {
          "description": "Handle result that will be used when handling message, if SetResult was not explicitly called",
          "default": 0,
          "oneOf": [
            {
              "$ref": "#/definitions/MessageHandleResultKind"
            }
          ]
        },
        "RetryCount": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32",
          "maximum": 2147483647.0,
          "minimum": 0.0
        }
      },
      "definitions": {
        "MessageHandleResultKind": {
          "type": "integer",
          "description": "",
          "x-enumNames": [
            "Success",
            "Failure",
            "Ignored"
          ],
          "enum": [
            0,
            1,
            2
          ]
        }
      }
    },
    "Itmo_Dev_Platform_Kafka_Consumer_KafkaConsumerOptions": {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "KafkaConsumerOptions",
      "type": "object",
      "required": [
        "Topic",
        "Group"
      ],
      "properties": {
        "IsDisabled": {
          "type": "boolean"
        },
        "Topic": {
          "type": "string",
          "minLength": 1
        },
        "Group": {
          "type": "string",
          "minLength": 1
        },
        "InstanceId": {
          "type": "string"
        },
        "ParallelismDegree": {
          "type": "integer",
          "format": "int32",
          "default": 1,
          "maximum": 2147483647.0,
          "minimum": 1.0
        },
        "BufferSize": {
          "type": "integer",
          "format": "int32",
          "default": 1,
          "maximum": 2147483647.0,
          "minimum": 1.0
        },
        "BufferWaitLimit": {
          "type": "string",
          "default": "00:00:00",
          "pattern": "^-?(\\d+\\.)?([01]?\\d|2[0-3]):([0-5]?\\d):([0-5]?\\d)(\\.\\d{1,7})?$"
        },
        "ReadLatest": {
          "type": "boolean"
        }
      }
    },
    "Itmo_Dev_Platform_Options_Samples_SomeOptions": {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "SomeOptions",
      "type": "object",
      "required": [
        "OtherValue"
      ],
      "properties": {
        "Value": {
          "type": "integer",
          "format": "int32"
        },
        "OtherValue": {
          "type": "string"
        }
      }
    },
    "Itmo_Dev_Platform_MessagePersistence_Options_MessagePersistencePublisherOptions": {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "MessagePersistencePublisherOptions",
      "type": "object",
      "properties": {
        "BatchSize": {
          "type": "integer",
          "format": "int32",
          "maximum": 2147483647.0,
          "minimum": 1.0
        },
        "PollingDelay": {
          "type": "string",
          "pattern": "^-?(\\d+\\.)?([01]?\\d|2[0-3]):([0-5]?\\d):([0-5]?\\d)(\\.\\d{1,7})?$"
        }
      }
    },
    "Itmo_Dev_Platform_Persistence_Postgres_Models_PostgresConnectionOptions": {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "PostgresConnectionOptions",
      "type": "object",
      "required": [
        "Host",
        "Port",
        "Database",
        "Username",
        "Password"
      ],
      "properties": {
        "Host": {
          "type": "string",
          "minLength": 1
        },
        "Port": {
          "type": "integer",
          "format": "int32",
          "maximum": 2147483647.0,
          "minimum": 1.0
        },
        "Database": {
          "type": "string",
          "minLength": 1
        },
        "Username": {
          "type": "string",
          "minLength": 1
        },
        "Password": {
          "type": "string",
          "minLength": 1
        },
        "SslMode": {
          "type": "string"
        },
        "Pooling": {
          "type": "boolean",
          "default": true
        },
        "MaximumPoolSize": {
          "type": "integer",
          "format": "int32",
          "default": 10,
          "maximum": 2147483647.0,
          "minimum": 1.0
        },
        "EnableConnectionProviderLogging": {
          "type": "boolean"
        }
      }
    },
    "Itmo_Dev_Platform_Observability_Metrics_PlatformMetricsOptions": {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "PlatformMetricsOptions",
      "type": "object",
      "required": [
        "IsEnabled"
      ],
      "properties": {
        "IsEnabled": {
          "type": "boolean"
        }
      }
    },
