<Project>

    <PropertyGroup Condition="'$(_UsePlatformOptions)' == 'true'">
        <_OptionsTasksAssembly>$(MSBuildThisFileDirectory)bin\$(Configuration)\net10.0\Itmo.Dev.Platform.Options.MSBuild.dll</_OptionsTasksAssembly>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_UsePlatformOptions)' != 'true'">
        <_OptionsTasksAssembly>$(MSBuildThisFileDirectory)..\tasks\net10.0\Itmo.Dev.Platform.Options.MSBuild.dll</_OptionsTasksAssembly>
    </PropertyGroup>

    <UsingTask TaskName="Itmo.Dev.Platform.Options.MSBuild.Tasks.CurrentSchemaGeneration.GenerateCurrentSchemaBuildTask"
               AssemblyFile="$(_OptionsTasksAssembly)"/>

</Project>